// Copy to Config/Secrets.xcconfig (gitignored) and fill in.
// Prototype only: a key embedded in an app binary is extractable.
// Production routes model calls through a backend proxy (see README).
GEMINI_API_KEY = your-key-here
// Optional override:
// GEMINI_MODEL = gemini-2.5-flash
// Primary model only: leave blank to use model defaults (e.g. when thinking cannot be disabled).
// GEMINI_THINKING_BUDGET =
// Comma-separated model IDs, offered as additional choices in Ask:
// GEMINI_ALTERNATE_MODELS = gemini-2.5-flash,gemini-2.5-pro
// Additional model choices use their default thinking configuration.
// Optional launch selection: gemini, apple, or mock. No automatic provider fallback.
// ASSISTANT_PROVIDER = apple
