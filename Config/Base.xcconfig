// Shared build settings for the app target.
// The Gemini key is NOT committed. Create Config/Secrets.xcconfig from
// Config/Secrets.example.xcconfig. Without it the app falls back to the
// clearly-labeled simulated model.
GEMINI_API_KEY =
GEMINI_MODEL = gemini-flash-latest
GEMINI_THINKING_BUDGET = 0
GEMINI_ALTERNATE_MODELS =
ASSISTANT_PROVIDER =

#include? "Secrets.xcconfig"
